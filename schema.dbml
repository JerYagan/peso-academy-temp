Project peso_academy {
  database_type: 'PostgreSQL'
  Note: 'Derived from Supabase migrations through 072_fix_course_scoped_assessment_attempt_rls.sql. Legacy jobs and job_applications tables were dropped in migration 023 and are intentionally excluded. auth.users is included as a minimal external stub for foreign-key references.'
}

Enum user_role {
  admin
  trainer
  trainee
}

Enum course_level {
  Beginner
  Intermediate
  Advanced
}

Enum enrollment_status {
  enrolled
  in-progress
  completed
  dropped
}

Enum submission_status {
  pending
  approved
  rejected
  revision_requested
}

Enum certificate_type {
  completion
  participation
}

Enum question_type {
  multiple_choice
  true_false
  short_answer
  essay
}

Table auth.users {
  id uuid [pk]

  Note: 'External Supabase auth table stub used only for foreign-key references from public schema objects.'
}

Table public.role_aliases {
  role_code text [pk]
  display_name text [not null]
  description text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: 'role_code is check-constrained in the live database to admin, trainer, or trainee.'
}

Table public.permissions {
  id text [pk]
  name text [not null]
  description text [not null]
  category text [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table public.roles {
  id text [pk]
  name text [not null]
  description text [not null]
  category text [not null]
  icon text
  color text
  dashboard_route text [not null]
  can_signup boolean [not null]
  metadata jsonb
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: 'category is check-constrained to internal or end_user.'
}

Table public.role_permissions {
  id uuid [pk]
  role_id text [not null]
  permission_id text [not null]
  created_at timestamptz [not null]

  Indexes {
    (role_id, permission_id) [unique]
  }
}

Table public.users {
  id uuid [pk]
  email text [not null, unique]
  name text [not null]
  role user_role [not null]
  trainee_type text
  verification_status text [not null]
  employee_id text
  physical_id text
  verification_submitted_at timestamptz
  verified_at timestamptz
  verified_by uuid
  verification_notes text
  onboarding_modal_seen_at timestamptz
  avatar text
  phone text
  address text
  date_of_birth date
  gender text
  civil_status text
  employment_status text
  occupation text
  education_level text
  barangay text
  city_municipality text
  province text
  postal_code text
  industry_interests text[]
  preferred_categories text[]
  onboarding_skill_level text
  onboarding_confidence_level text
  onboarding_weekly_commitment text
  onboarding_digital_comfort text
  onboarding_completed_at timestamptz
  language_preference text [not null]
  theme_preference text [not null]
  skills text[]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: 'Several profile preference and verification fields are text columns with check constraints in SQL migrations, including trainee_type, verification_status, onboarding_skill_level, onboarding_confidence_level, onboarding_weekly_commitment, onboarding_digital_comfort, language_preference, theme_preference, gender, civil_status, employment_status, and phone format.'
}

Table public.user_permissions {
  id uuid [pk]
  user_id uuid [not null]
  permission_id text [not null]
  granted_by uuid
  granted_at timestamptz [not null]
  created_at timestamptz [not null]

  Indexes {
    (user_id, permission_id) [unique]
  }
}

Table public.audit_logs {
  id uuid [pk]
  user_id uuid
  event_type varchar(50) [not null]
  event_category varchar(50) [not null]
  description text
  ip_address inet
  user_agent text
  metadata jsonb
  success boolean
  error_message text
  created_at timestamptz [not null]
}

Table public.programs {
  id uuid [pk]
  title text [not null, unique]
  description text [not null]
  category text
  created_by uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table public.courses {
  id uuid [pk]
  title text [not null]
  description text [not null]
  category text [not null]
  level course_level [not null]
  duration integer [not null]
  instructor_id uuid [not null]
  program_id uuid
  thumbnail text
  is_tesda_accredited boolean [not null]
  skills text[] [not null]
  skill_tags text[] [not null]
  topic_tags text[] [not null]
  industry_tags text[] [not null]
  career_paths text[] [not null]
  enrolled_count integer [not null]
  rating numeric(3,2) [not null]
  certificate_type certificate_type [not null]
  published boolean [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: 'category, skill_tags, and topic_tags are further constrained by taxonomy validation checks in later migrations.'
}

Table public.modules {
  id uuid [pk]
  course_id uuid [not null]
  title text [not null]
  description text [not null]
  order integer [not null]
  content text
  module_document text
  materials text[]
  prerequisites text[]
  module_thumbnail text
  status text [not null]
  skill_tags text[] [not null]
  topic_tags text[] [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: 'status is stored as text with a live check constraint limiting values to draft or finalized.'
}

Table public.assessments {
  id uuid [pk]
  course_id uuid [not null]
  module_id uuid
  title text [not null]
  description text
  assessment_thumbnail text
  time_limit integer
  passing_score integer
  max_attempts integer
  allow_retry_after_passing boolean [not null]
  is_active boolean [not null]
  prerequisite_module_ids uuid[] [not null]
  derived_from_module_quiz boolean [not null]
  skill_tags text[] [not null]
  topic_tags text[] [not null]
  display_order integer [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Indexes {
    (module_id) [unique]
  }
}

Table public.assessment_questions {
  id uuid [pk]
  assessment_id uuid [not null]
  question text [not null]
  question_type question_type [not null]
  options jsonb
  correct_answer text
  points integer [not null]
  order integer [not null]
  explanation text
  source_question_key text
  derived_from_module_quiz boolean [not null]
  is_active boolean [not null]
  skill_tags text[] [not null]
  topic_tags text[] [not null]
  created_at timestamptz [not null]

  Note: 'The live schema also has a partial unique index on (assessment_id, source_question_key) where source_question_key is not null and is_active = true.'
}

Table public.assessment_attempts {
  id uuid [pk]
  assessment_id uuid [not null]
  enrollment_id uuid [not null]
  user_id uuid [not null]
  started_at timestamptz [not null]
  submitted_at timestamptz
  score integer
  passed boolean
  answers jsonb [not null]
  time_spent integer
  review_status text
  requires_manual_review boolean [not null]
  reviewed_at timestamptz
  reviewed_by uuid
  review_feedback text

  Note: 'review_status is a text column with a check constraint limiting values to submitted, under_review, needs_revision, or approved.'
}

Table public.assessment_answers {
  id uuid [pk]
  attempt_id uuid [not null]
  question_id uuid [not null]
  answer text [not null]
  is_correct boolean
  points_earned integer
  feedback text
  review_status text
  reviewed_at timestamptz
  reviewed_by uuid

  Note: 'review_status is a text column with a check constraint limiting values to submitted, under_review, needs_revision, or approved.'
}

Table public.learner_recommendations {
  id uuid [pk]
  user_id uuid [not null]
  course_id uuid [not null]
  source_surface text [not null]
  rank integer [not null]
  score numeric(10,4) [not null]
  acceptance_probability numeric(6,2) [not null]
  acceptance_band text [not null]
  reasons jsonb [not null]
  source_mix jsonb [not null]
  recommendation_context jsonb [not null]
  model_version text [not null]
  generated_at timestamptz [not null]
  last_impression_at timestamptz
  last_click_at timestamptz
  last_accept_at timestamptz
  impression_count integer [not null]
  click_count integer [not null]
  accept_count integer [not null]
  enrollment_count integer [not null]
  completion_count integer [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Indexes {
    (user_id, course_id, source_surface) [unique]
  }
}

Table public.enrollments {
  id uuid [pk]
  user_id uuid [not null]
  course_id uuid [not null]
  progress integer [not null]
  status enrollment_status [not null]
  enrolled_at timestamptz [not null]
  completed_at timestamptz
  certificate_id uuid
  originating_recommendation_id uuid
  completion_approval_status text [not null]
  completion_requested_at timestamptz
  completion_reviewed_at timestamptz
  completion_reviewed_by uuid
  completion_feedback text
  credited_duration_hours integer
  actual_learning_minutes integer
  updated_at timestamptz [not null]

  Indexes {
    (user_id, course_id) [unique]
  }

  Note: 'certificate_id remains an unconstrained UUID column in the live schema. completion_approval_status is text with a check constraint limiting values to not_ready, pending, approved, or needs_revision.'
}

Table public.enrollment_history {
  id uuid [pk]
  enrollment_id uuid
  user_id uuid
  course_id uuid
  action varchar(50) [not null]
  old_status varchar(50)
  new_status varchar(50)
